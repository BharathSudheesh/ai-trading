# Copy to .env to override defaults. All variables use the TA_ prefix.

# auto: use Yahoo Finance when reachable, otherwise deterministic synthetic demo data
# yfinance: live data only (fails if unreachable) | synthetic: always demo data
TA_DATA_SOURCE=auto

# random_forest | xgboost
TA_ML_ALGORITHM=random_forest

# JSON list, used when a profile has no preferred assets
TA_DEFAULT_SYMBOLS=["AAPL","MSFT","NVDA","JPM","XOM"]

TA_HISTORY_YEARS=5
TA_HORIZON_DAYS=5
TA_STARTING_CASH=100000
TA_COMMISSION_BPS=5
TA_SLIPPAGE_BPS=5
TA_DATA_DIR=./data
